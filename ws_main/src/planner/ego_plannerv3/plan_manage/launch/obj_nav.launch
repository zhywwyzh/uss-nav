        <param name="ObstacleShape/radius_h" value="0.5"/>
        <param name="ObstacleShape/z_l" value="-0.5"/>
        <param name="ObstacleShape/z_h" value="2.5"/>
        <param name="ObstacleShape/theta" value="1.5"/>
        <param name="pub_rate" value="1.0"/>
        <param name="min_distance" value="0.0"/>
    </node> -->



  <!-- map generation 4-->
  <!-- Using pyhton to generate map -->
    <!-- <node pkg ="map_generator" name ="map_generator_easy" type ="map_generator_easy2.py" output = "screen" respawn="true" >
