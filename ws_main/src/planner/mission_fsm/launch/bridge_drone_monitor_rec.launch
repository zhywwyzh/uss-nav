<?xml version="1.0"?>
<launch>
    <group ns="bridge_monitor">
        <node pkg="swarm_ros_bridge" type="bridge_new" name="swarm_bridge_monitor_node" output="screen">
            <param name="hostname" type="string" value="drone1"/>
            <rosparam command="load" file="$(find swarm_ros_bridge)/config/monitor_rec.yaml"/>
            <rosparam command="load" file="$(find swarm_ros_bridge)/config/ip_real.yaml"/>
        </node>
    </group>
</launch>
